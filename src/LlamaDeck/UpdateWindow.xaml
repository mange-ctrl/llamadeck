<Window x:Class="LlamaDeck.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uppdateringar – LlamaDeck"
        Width="820" Height="780"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Uppdateringar" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="llama.cpp, CUDA, ROCm, SYCL, Vulkan och OpenCL – hämta nya versioner direkt i programmet."
                           FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button x:Name="RefreshBtn" Content="Sök igen" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="Refresh_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel x:Name="RowsPanel" />
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0D1118" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12" Margin="0,14,0,0">
            <TextBox x:Name="UpdateLog" Height="86" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="#8E9BB0"
                     VerticalScrollBarVisibility="Auto" />
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="Kontrollerar versioner …" FontSize="11.5"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <Button Content="Stäng" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
