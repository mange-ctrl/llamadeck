<Window x:Class="LlamaDeck.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hjälp – LlamaDeck"
        Width="780" Height="700"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Så fungerar LlamaDeck" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="En liten servicedesk för llama.cpp – allt du behöver för att köra en lokal LLM."
                       FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel x:Name="ContentPanel" />
        </ScrollViewer>

        <Button Grid.Row="2" Content="Stäng" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                Margin="0,16,0,0" Click="Close_Click" />
    </Grid>
</Window>
